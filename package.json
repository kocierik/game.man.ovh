{
  "name": "game-man-ovh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "npm run typecheck && vite build",
    "start": "node server/index.js",
    "test": "node --test",
    "test:e2e": "playwright test",
    "lint": "eslint server tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "express": "^5.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
